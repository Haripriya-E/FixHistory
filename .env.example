# ---------------------------------------------------------------
# FixHistory environment configuration
#
# HOW TO USE
#   1. Run `npm run setup` from the FixHistory folder. It copies this
#      file to `.env` and fills JWT_SECRET with a random value.
#      (Or copy it manually:  copy .env.example .env )
#   2. Edit MONGODB_URI if you use MongoDB Atlas.
#
# Never commit the real `.env` file. It is listed in .gitignore.
# ---------------------------------------------------------------

# development | production
NODE_ENV=development

# Port of the Express API server
PORT=5000

# MongoDB connection string
#   Local MongoDB (default):  mongodb://127.0.0.1:27017/fixhistory
#   MongoDB Atlas example:    mongodb+srv://<username>:<password>@<cluster-host>/fixhistory?retryWrites=true&w=majority
# Use 127.0.0.1 instead of "localhost" for local MongoDB on Windows.
MONGODB_URI=mongodb://127.0.0.1:27017/fixhistory

# Secret used to sign login tokens (JWT). Use at least 32 random characters.
# `npm run setup` generates one for you.
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters

# How long a login session lasts (examples: 12h, 7d)
JWT_EXPIRES_IN=7d

# Address of the React app (used for CORS)
CLIENT_URL=http://localhost:5173

# Base address encoded inside asset QR codes.
# To scan QR codes with a phone on the same Wi-Fi, set this to your laptop's
# network address, for example http://192.168.1.20:5173 (see README).
PUBLIC_APP_URL=http://localhost:5173

# Set to true only when the app is served over HTTPS
COOKIE_SECURE=false

# Maximum upload size for asset images and invoices (megabytes)
MAX_UPLOAD_MB=5

# How many days ahead the app starts reminding you about services and warranty expiry
REMINDER_WINDOW_DAYS=30

# How long an ownership transfer code stays valid (hours)
TRANSFER_EXPIRY_HOURS=72
